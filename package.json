{
  "name": "epic-inline",
  "description": "Concise way to write runtime inline CSS styles.",
  "version": "0.0.0-development",
  "repository": "github:tobua/epic-inline",
  "homepage": "https://tobua.github.io/epic-inline",
  "license": "MIT",
  "author": "Matthias Giger",
  "scripts": {
    "app": "bun create-app.js",
    "app:copy": "cpx '**/*.ts' app/node_modules/epic-inline --watch",
    "check": "biome check --write .",
    "types": "tsc"
  },
  "dependencies": {
    "@types/color-convert": "^3.0.1",
    "@types/parse-color": "^1.0.3",
    "@types/simple-swizzle": "^0.2.2",
    "color-convert": "^3.1.3",
    "parse-color": "^1.0.0",
    "simple-swizzle": "^0.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@happy-dom/global-registrator": "^20.11.2",
    "@npmcli/arborist": "^10.0.2",
    "@types/bun": "^1.3.14",
    "cpx": "^1.5.0",
    "epic-jsx": "^0.14.0",
    "npm-packlist": "^11.3.0",
    "typescript": "^7.0.2",
    "zero-configuration": "^1.2.0"
  },
  "trustedDependencies": [
    "zero-configuration"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./register-jsx": {
      "default": "./register-jsx.ts"
    }
  },
  "files": [
    "*.ts"
  ],
  "keywords": [
    "style",
    "inline",
    "css",
    "react",
    "inline-styles"
  ],
  "configuration": {
    "gitignore": [
      "extends:recommended",
      "InlineApp",
      "app/**/*",
      "!app/App.tsx"
    ],
    "vscode": "biome",
    "biome": [
      {
        "extends": "recommended",
        "linter": {
          "rules": {
            "performance": {
              "useTopLevelRegex": "off"
            },
            "style": {
              "noMagicNumbers": "off"
            }
          }
        },
        "files": {
          "includes": [
            "**/*",
            "!app",
            "!documentation"
          ]
        }
      },
      {
        "extends": "test",
        "folder": "test",
        "root": false
      }
    ],
    "typescript": [
      {
        "extends": "plugin",
        "compilerOptions": {
          "types": [
            "bun"
          ]
        },
        "files": [
          "index.ts"
        ]
      },
      {
        "extends": "plugin",
        "folder": "test",
        "compilerOptions": {
          "strict": false,
          "types": [
            "bun"
          ],
          "paths": {
            "react": [
              "./../node_modules/epic-jsx"
            ],
            "react/jsx-runtime": [
              "./../node_modules/epic-jsx"
            ],
            "react/jsx-dev-runtime": [
              "./../node_modules/epic-jsx"
            ]
          }
        }
      }
    ]
  }
}
